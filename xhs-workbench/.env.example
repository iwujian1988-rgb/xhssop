OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CONTENT_PIPELINE_VERSION=v2

# Product fact indexes. Absolute paths are allowed for local deployment.
DELF_PRODUCT_FACTS_PATH=D:\\path\\to\\product_facts.json
TEF_TCF_PRODUCT_FACTS_PATH=D:\\path\\to\\product_facts_tef_tcf.json
TCF_CANADA_WRITING_7DAY_FACTS_PATH=D:\\path\\to\\product_facts_tcf_canada_7day.json

# Image generation. Keep the real key only in .env.local.
IMAGE_API_KEY=sk-your-image-key
IMAGE_API_BASE_URL=https://zexapi.com
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_PROVIDER=zexapi
